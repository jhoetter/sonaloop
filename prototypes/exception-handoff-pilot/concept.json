{
  "title": "Exception handoff pilot",
  "summary": "A two-screen flow for shift leads to capture one exception and see owner/date/status follow-up.",
  "start": "capture",
  "screens": [
    {
      "id": "capture",
      "title": "Capture exception",
      "elements": [
        {
          "id": "intro",
          "kind": "text",
          "text": "Capture one exception that the next shift must not reconstruct."
        },
        {
          "id": "issue",
          "kind": "input",
          "label": "Issue summary"
        },
        {
          "id": "previous_action",
          "kind": "input",
          "label": "Previous action"
        },
        {
          "id": "consequence",
          "kind": "input",
          "label": "Operational consequence"
        },
        {
          "id": "owner",
          "kind": "select",
          "label": "Owner",
          "options": [
            "Nina",
            "Tarek",
            "Janine"
          ]
        },
        {
          "id": "due_date",
          "kind": "input",
          "label": "Due date"
        },
        {
          "id": "privacy",
          "kind": "text",
          "text": "Do not enter names from small groups unless follow-up owner needs them."
        },
        {
          "id": "submit",
          "kind": "button",
          "label": "Create follow-up",
          "goto": "followup",
          "action": "followup"
        }
      ]
    },
    {
      "id": "followup",
      "title": "Follow-up list",
      "elements": [
        {
          "id": "summary",
          "kind": "text",
          "text": "Owner, due date, status and previous action are visible to the next shift."
        },
        {
          "id": "status",
          "kind": "select",
          "label": "Status",
          "options": [
            "Open",
            "In progress",
            "Closed"
          ]
        },
        {
          "id": "fix_marker",
          "kind": "text",
          "text": "Visible fix required within one week for the pilot to count."
        },
        {
          "id": "back",
          "kind": "button",
          "label": "Edit exception",
          "goto": "capture",
          "action": "capture"
        }
      ]
    }
  ]
}