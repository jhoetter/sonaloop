{
  "key": "lean_jtbd",
  "name": "Lean / Jobs-to-be-Done",
  "description": "Problem-explore (fan) -> Problem-pick (waist) -> Solution-explore (fan + prototype) -> Validate (waist). Lean-startup framing around the customer's job-to-be-done.",
  "when_to_use": "When you want to anchor on the customer's job, find the highest-value problem, then validate a minimal solution.",
  "routing": {
    "aliases": ["lean JTBD", "jobs to be done"],
    "threshold": 5,
    "ambiguity_margin": 2,
    "signals": [
      {"phrase": "lean jtbd", "weight": 8},
      {"phrase": "jobs to be done", "weight": 7},
      {"phrase": "job to be done", "weight": 7},
      {"phrase": "kundenjob", "weight": 6},
      {"phrase": "customer job", "weight": 6},
      {"phrase": "minimal solution", "weight": 5},
      {"phrase": "minimale losung", "weight": 5},
      {"phrase": "mvp validieren", "weight": 5},
      {"phrase": "hochwertigstes problem", "weight": 5}
    ]
  },
  "presentation": {
    "icon": "jtbd",
    "image": "lean-jtbd.jpg",
    "figure": "signal",
    "complexity": "medium",
    "summary": "Anchor on the job-to-be-done, pick the strongest problem, validate a minimal answer.",
    "jobs": "Demand, pricing, churn, and MVP questions where the customer job is the anchor.",
    "deck": {
      "purpose": "Connect the customer job and highest-value struggle to a tested minimal answer and next experiment.",
      "story_beats": [
        {"role": "job_context", "question": "What progress is the customer trying to make?", "preferred_visuals": ["quote", "timeline"]},
        {"role": "problem_pick", "question": "Which underserved struggle is worth solving first?", "preferred_visuals": ["decision", "table"]},
        {"role": "hypothesis", "question": "What minimal answer should change behavior?", "preferred_visuals": ["comparison", "stimulus_comparison"]},
        {"role": "validation", "question": "What did the test validate or falsify?", "preferred_visuals": ["chart", "annotated_screen", "preference_shift"]},
        {"role": "learning", "question": "What is the next smallest useful experiment?", "preferred_visuals": ["recommendation", "next_steps"]}
      ],
      "required_visuals": ["job statement", "chosen struggle", "MVP or hypothesis", "test result", "next experiment"],
      "appendix": ["job evidence", "persona details", "assumption register", "raw responses", "source index"],
      "avoid": ["confusing stated preference with demand", "showing feature lists before the job", "hiding falsified assumptions"]
    }
  },
  "steps": [
    {
      "id": "problem_explore", "name": "Problem Explore", "tags": ["explore", "problem-landscape"],
      "intent": "Explore the jobs-to-be-done and the problems blocking them, broadly across customers.",
      "strategy": "pain-discovery", "diverge_by": "angle",
      "produces": {"role": "problem-landscape"},
      "presentation": {
        "forms": ["council/open_discussion"],
        "formats": ["Council: Discovery"],
        "library": ["Councils", "Notes", "Open questions"]
      }
    },
    {
      "id": "problem_pick", "name": "Problem Pick", "tags": ["decide", "point-of-view"],
      "intent": "Pick the single highest-value, most-underserved problem/job to solve first.",
      "strategy": "goal", "consumes": ["problem_explore"],
      "requires": {"min_inputs": 2, "gate_tag": "divergence_complete"},
      "produces": {"role": "point-of-view"},
      "presentation": {
        "forms": ["council/open_discussion", "council/option_comparison"],
        "formats": ["Council: Discovery", "Council: Head-to-Head"],
        "library": ["Councils", "Hypotheses", "Reports"]
      }
    },
    {
      "id": "solution_explore", "name": "Solution Explore", "tags": ["explore", "build", "solution-options"],
      "intent": "Explore solution/MVP candidates and build a minimal prototype.",
      "strategy": "positive-deepdive", "consumes": ["problem_pick"], "diverge_by": "solution_candidate",
      "produces": {"role": "solution-options", "artifact_type": "prototype"},
      "presentation": {
        "forms": ["council/open_discussion", "council/option_comparison"],
        "formats": ["Council: Discovery", "Council: Head-to-Head"],
        "library": ["Councils", "Prototypes", "Hypotheses"]
      }
    },
    {
      "id": "validate", "name": "Validate", "tags": ["decide", "test", "spec"],
      "intent": "Personas use the MVP; validate the value proposition and converge to a buildable spec.",
      "strategy": "tension", "consumes": ["solution_explore"],
      "requires": {"min_inputs": 2, "gate_tag": "divergence_complete", "session_of_tags": ["prototype"]},
      "produces": {"role": "spec"},
      "loop_back": "solution_explore",
      "presentation": {
        "forms": ["session/prototype_use", "council/objection_review"],
        "formats": ["Session: Prototype test", "Council: Red-Team"],
        "library": ["Sessions", "Councils", "Reports", "Decisions"]
      }
    }
  ]
}
