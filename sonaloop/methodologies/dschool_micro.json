{
  "key": "dschool_micro",
  "name": "d.school Micro-Cycle",
  "description": "Stanford d.school micro-cycle: Understand/Observe (fan) -> Define POV (waist) -> Ideate (fan + prototype) -> Prototype & Test (waist).",
  "when_to_use": "Human-centered design when you want empathy-first divergence and rapid prototype testing.",
  "routing": {
    "aliases": ["dschool", "d school", "Stanford design thinking"],
    "threshold": 5,
    "ambiguity_margin": 2,
    "signals": [
      {"phrase": "d school", "weight": 8},
      {"phrase": "stanford design thinking", "weight": 8},
      {"phrase": "empathy first", "weight": 6},
      {"phrase": "empathie zuerst", "weight": 6},
      {"phrase": "human centered design", "weight": 5},
      {"phrase": "menschenzentriert", "weight": 5},
      {"phrase": "define pov", "weight": 5},
      {"phrase": "rapid prototype", "weight": 4}
    ]
  },
  "presentation": {
    "icon": "designThinkingHmw",
    "image": "dschool-micro.jpg",
    "figure": "convene",
    "complexity": "medium",
    "summary": "Empathy-first divergence, a sharp POV, then rapid prototype testing.",
    "jobs": "Fast human-centered concept work and continuous discovery loops.",
    "deck": {
      "purpose": "Tell an empathy-led story from lived context to a rapidly tested prototype.",
      "story_beats": [
        {"role": "empathy", "question": "Whose lived context changes how we see the problem?", "preferred_visuals": ["persona_grid", "quote"]},
        {"role": "needs", "question": "Which needs and surprising insights matter most?", "preferred_visuals": ["summary", "quote"]},
        {"role": "pov", "question": "What is the focused point of view and HMW?", "preferred_visuals": ["decision"]},
        {"role": "ideas", "question": "Which different ideas were made tangible?", "preferred_visuals": ["stimulus_comparison", "image"]},
        {"role": "test", "question": "What changed after people used the prototype?", "preferred_visuals": ["annotated_screen", "preference_shift", "next_steps"]}
      ],
      "required_visuals": ["empathy voices", "POV", "idea breadth", "prototype", "test learning"],
      "appendix": ["persona details", "idea inventory", "test sessions", "source index"],
      "avoid": ["leading with process diagrams", "reducing empathy to demographics", "showing a prototype without the need it addresses"]
    }
  },
  "steps": [
    {
      "id": "understand_observe", "name": "Understand & Observe", "tags": ["explore", "problem-landscape"],
      "intent": "Build empathy: observe and surface user needs, contexts and frictions broadly.",
      "strategy": "pain-discovery", "diverge_by": "persona_subset",
      "produces": {"role": "problem-landscape"},
      "presentation": {
        "forms": ["council/open_discussion", "council/objection_review"],
        "formats": ["Council: Discovery", "Council: Red-Team"],
        "library": ["Councils", "Notes", "Open questions"]
      }
    },
    {
      "id": "define_pov", "name": "Define POV", "tags": ["decide", "point-of-view"],
      "intent": "Consolidate observations into a single Point-of-View statement (user + need + insight).",
      "strategy": "goal", "consumes": ["understand_observe"],
      "requires": {"min_inputs": 2, "gate_tag": "divergence_complete"},
      "produces": {"role": "point-of-view"},
      "presentation": {
        "forms": ["council/open_discussion"],
        "formats": ["Council: Discovery"],
        "library": ["Councils", "Reports", "Open questions"]
      }
    },
    {
      "id": "ideate", "name": "Ideate", "tags": ["explore", "build", "solution-options"],
      "intent": "Generate many diverse solution concepts; build a prototype for the most promising.",
      "strategy": "positive-deepdive", "consumes": ["define_pov"], "diverge_by": "solution_candidate",
      "produces": {"role": "solution-options", "artifact_type": "prototype"},
      "presentation": {
        "forms": ["council/idea_review", "council/option_comparison"],
        "formats": ["Council: Ideation", "Council: Head-to-Head"],
        "library": ["Councils", "Prototypes", "Notes"]
      }
    },
    {
      "id": "prototype_test", "name": "Prototype & Test", "tags": ["decide", "test", "spec"],
      "intent": "Personas use the prototype; gather feedback and converge to refined requirements.",
      "strategy": "tension", "consumes": ["ideate"],
      "requires": {"min_inputs": 2, "gate_tag": "divergence_complete", "session_of_tags": ["prototype"]},
      "produces": {"role": "spec"},
      "loop_back": "ideate",
      "presentation": {
        "forms": ["session/prototype_use"],
        "formats": ["Session: Prototype test"],
        "library": ["Sessions", "Reports", "Decisions"]
      }
    }
  ]
}
