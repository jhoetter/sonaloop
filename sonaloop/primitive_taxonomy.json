    {
      "id": "dashboard",
      "primitive": "prototype",
      "label": "Dashboard prototype",
      "description": "A dashboard-style prototype.",
      "aliases": [],
      "parameters": [{"id": "fidelity", "attribute": "prototype_fidelity"}],
      "schema": {"type": "object", "required": ["name"], "fields": {"name": "string", "fidelity": "attribute:prototype_fidelity"}},
      "renderer": {"library": "row", "detail": "prototype_detail"},
      "protocol": {"kind": "material", "outputs": ["prototype"]}
    },
    {
      "id": "cards",
      "primitive": "prototype",
