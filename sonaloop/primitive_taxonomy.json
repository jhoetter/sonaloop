      "renderer": {"library": "row", "detail": "reference_detail"},
      "protocol": {"kind": "material", "outputs": ["url_artifact"]}
    },
    {
      "id": "variant_reference",
      "primitive": "url_artifact",
      "label": "Variant reference",
      "description": "One labelled side of an A/B or multi-variant comparison.",
