      "aliases": [],
      "schema": {"type": "object", "required": ["filename"], "fields": {"filename": "string", "direction": "attribute:asset_direction"}},
      "renderer": {"library": "row", "detail": "asset_detail"},
      "protocol": {"kind": "material", "outputs": ["asset"]}
    },
    {
      "id": "file",
      "primitive": "asset",
      "label": "File",
      "description": "A generic attached file.",
      "aliases": [],
      "schema": {"type": "object", "required": ["filename"], "fields": {"filename": "string", "direction": "attribute:asset_direction"}},
      "renderer": {"library": "row", "detail": "asset_detail"},
      "protocol": {"kind": "material", "outputs": ["asset"]}
    },
    {
