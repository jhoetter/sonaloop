{
  "schema": "sonaloop.primitive_taxonomy.registry",
  "version": 1,
  "custom_form_policy": {
    "default": "reject_unknown",
    "workspace_custom_forms": "allowed_only_when_registered",
    "id_pattern": "^[a-z][a-z0-9_]*$",
    "notes": "Unknown LLM-authored values must not create primitives or forms. A custom form must extend a registered base form and declare a compatible schema and renderer."
  },
  "families": [
    {"id": "frame", "label": "Frame", "description": "Questions and bets that frame the work.", "icon": "help"},
    {"id": "material", "label": "Material", "description": "Inputs and testable material shown or attached.", "icon": "file"},
    {"id": "ask", "label": "Ask", "description": "Structured ways to ask personas or real people.", "icon": "councils"},
    {"id": "test", "label": "Test", "description": "Observed runs against material or live surfaces.", "icon": "prototype"},
    {"id": "capture", "label": "Capture", "description": "Lightweight captured signals and concepts.", "icon": "panel"},
    {"id": "conclude", "label": "Conclude", "description": "Synthesized answers and commitments.", "icon": "syntheses"},
    {"id": "structure", "label": "Structure", "description": "Grouping and relationship primitives.", "icon": "squareGrid"}
  ],
  "primitives": [
    {"id": "open_question", "family": "frame", "label": "Question", "description": "A research uncertainty that still needs work.", "icon": "help", "color": "#c98218"},
    {"id": "hypothesis", "family": "frame", "label": "Hypothesis", "description": "A falsifiable bet with metric and expected value or direction.", "icon": "target", "color": "#e0820a"},
    {"id": "url_artifact", "family": "material", "label": "Reference", "description": "Linked material such as a website, external prototype or variant.", "icon": "link", "color": "#3a7bd5"},
    {"id": "asset", "family": "material", "label": "Asset", "description": "A stored file, either evidence-in or deliverable-out.", "icon": "file", "color": "#5f6f7a"},
    {"id": "prototype", "family": "material", "label": "Prototype", "description": "A testable surface or model personas can inspect or use.", "icon": "prototype", "color": "#0f9d8f"},
    {"id": "council", "family": "ask", "label": "Council", "description": "A moderated persona round.", "icon": "councils", "color": "#6d5ef0"},
    {"id": "survey", "family": "ask", "label": "Survey", "description": "A structured questionnaire for real responses.", "icon": "plan", "color": "#6b7cff"},
    {"id": "session", "family": "test", "label": "Session", "description": "A recorded test run through a walkthrough, prototype or live URL.", "icon": "activity", "color": "#3d7fc4"},
    {"id": "note", "family": "capture", "label": "Note", "description": "A captured signal, observation, idea or concept.", "icon": "panel", "color": "#ff9800"},
    {"id": "synthesis", "family": "conclude", "label": "Synthesis", "description": "An analysis that turns evidence into interpretation.", "icon": "syntheses", "color": "#6d5ef0"},
    {"id": "report", "family": "conclude", "label": "Report", "description": "A presentation-ready analysis report.", "icon": "syntheses", "color": "#6d5ef0"},
    {"id": "decision", "family": "conclude", "label": "Decision", "description": "An evidence-backed commitment record.", "icon": "flag", "color": "#c0476b"},
    {"id": "section", "family": "structure", "label": "Section", "description": "A grouping overlay over existing project nodes.", "icon": "squareGrid", "color": "#8a6d3b"},
    {"id": "edge", "family": "structure", "label": "Edge", "description": "A typed relationship between two project nodes.", "icon": "arrowRight", "color": "#8a6d3b"}
  ],
  "forms": [
    {
      "id": "open_question",
      "primitive": "open_question",
      "label": "Open question",
      "description": "A research question that still needs resolution.",
      "aliases": ["question"],
      "schema": {"type": "object", "required": ["text"], "fields": {"text": "string", "status": "status:question_status"}},
      "renderer": {"library": "row", "detail": "question_detail"},
      "protocol": {"kind": "frame", "outputs": ["open_question"]}
    },
    {
      "id": "how_might_we",
      "primitive": "open_question",
      "label": "How might we",
      "description": "A generative framing question for methodology runs.",
      "aliases": ["hmw"],
      "schema": {"type": "object", "required": ["text"], "fields": {"text": "string", "source_problem": "string?"}},
      "renderer": {"library": "row", "detail": "question_detail"},
      "protocol": {"kind": "frame", "outputs": ["open_question"]}
    },
    {
      "id": "hypothesis",
      "primitive": "hypothesis",
      "label": "Hypothesis",
      "description": "A falsifiable bet with a metric and expected value or direction.",
      "aliases": [],
      "schema": {"type": "object", "required": ["text", "prediction"], "fields": {"text": "string", "prediction": "object", "status": "status:hypothesis_status"}},
      "renderer": {"library": "row", "detail": "hypothesis_detail"},
      "protocol": {"kind": "frame", "outputs": ["hypothesis"]}
    },
    {
