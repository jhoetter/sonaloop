  "digests": [
    {
      "id": "digest_f1407ef21d8bdb64",
      "persona_id": "persona_991687e2c4d1368c",
      "period_start": "2026-06-11",
      "period_end": "2026-06-18",
      "summary": "Die Woche zeigt ein stabiles Muster: fremdbestimmte Termine zerreißen Essensfenster, aber kleine sichtbare Pausenanker funktionieren besser als ambitionierte Wochenpläne.",
      "themes": [
        "Pausenanker",
        "Abendroutine",
        "fremdbestimmter Tagesrhythmus"
      ],
      "created_at": "2026-06-10T17:46:32.262049+00:00",
      "scope": "week"
    },
    {
      "id": "digest_ab41d3a6bd884fac",
      "persona_id": "persona_991687e2c4d1368c",
      "scope": "llm_authored_memory_depth",
      "period_start": "2026-04-21",
      "period_end": "2026-06-22",
      "summary": "Über zwei Monate verschiebt sich Amelies Kampf um ein verlässliches Essensfenster vom reinen Improvisieren zu echten Strukturen: Erst frisst die Quartalsbürokratie und ein verspäteter Termin ihre Pausen, dann kippt nach einem schwierigen Elterngespräch mit Finns Familie die Abendroutine in Toast-um-neun-Nachholstress. Der Vorsatz zum Vorkochen reift langsam, kollidiert unterwegs mit einer Familienfeier-Erwartung, und greift schließlich Anfang Juni mit vorgekochten Linsen-Portionen. Der Durchbruch ist ein fest im Dienstplan verankerter Mittwochs-Pausenblock, der zusammen mit der gefüllten Pausenbox einen chaotischen Personalausfalltag am 22. Juni trägt – Amelie ist abends erschöpft, aber zum ersten Mal nicht ausgehungert und beginnt, ihre Grenzen klar zu kommunizieren.",
      "created_at": "2026-06-15T08:09:19+00:00"
    }
  ]
