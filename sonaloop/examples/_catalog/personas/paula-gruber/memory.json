      "persona_id": "persona_078ad78989c2f3e0",
      "entity_id": "ent_38b81b5542a82409",
      "text": "Paula und Samira muessen nach einigen Diensten auswerten, ob Drei-Minuten-Abfanghilfen und das Punktzeichen gegenseitig tragfaehig sind.",
      "status": "open",
      "opened_on": "2026-02-06",
      "closed_on": null,
      "created_at": "2026-06-15T13:32:48+00:00",
      "updated_at": "2026-06-15T13:32:48+00:00"
    },
    {
