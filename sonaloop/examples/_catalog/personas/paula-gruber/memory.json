      "created_at": "2026-06-15T13:32:48+00:00",
      "updated_at": "2026-06-15T13:32:48+00:00"
    },
    {
      "id": "thread_32b31f694b7446f0",
      "persona_id": "persona_078ad78989c2f3e0",
      "entity_id": "ent_f89f505f5d734c76",
      "text": "Paula beobachtet, ob der Familienkontakt feste Antwortzeiten nach Spaetdiensten akzeptiert oder weiter Sofortreaktionen erwartet.",
      "status": "open",
      "opened_on": "2026-03-27",
