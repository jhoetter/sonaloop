      "persona_id": "persona_078ad78989c2f3e0",
      "entity_id": "ent_d5d92d7292fb4efc",
      "text": "Paula sammelt weiter markierte Raumwechsel und Wegezeiten, um den Test mit frueher endendem Atemgruppenblock bewerten zu koennen.",
      "status": "open",
      "opened_on": "2026-04-29",
      "closed_on": null,
      "created_at": "2026-06-15T13:32:48+00:00",
      "updated_at": "2026-06-15T13:32:48+00:00"
    },
    {
      "id": "thread_1db8dbd4363a4474",
      "persona_id": "persona_078ad78989c2f3e0",
      "entity_id": "ent_b534287a8ff84573",
      "text": "Paula will drei guenstige, koerperlich vertraegliche Bahnhof- oder Supermarktoptionen auf eine Karte in der Pausenbox schreiben.",
      "status": "open",
      "opened_on": "2026-05-21",
