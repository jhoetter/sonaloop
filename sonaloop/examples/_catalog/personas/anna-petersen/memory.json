  "digests": [
    {
      "id": "digest_2eb685d23c5b4ec1",
      "persona_id": "persona_a7b9293ffff3e824",
      "scope": "llm_authored_memory_depth",
      "period_start": "2026-04-22",
      "period_end": "2026-06-14",
      "summary": "Über knapp zwei Monate verfestigte sich für Anna der rote Faden vom Drei-Uhr-Loch am Automaten hin zu einer funktionierenden Vorkoch-Routine: Aus einem frustrierenden Leer-Automaten im April wurde mit Jonas der Sonntags-Vorkochtag, der bis Mitte Juni tatsächlich durchzog und sogar eine Extradose für Meltem umfasst. Parallel brachte sie ihren lange hängenden Juli-Dienstplanwunsch schriftlich durch und bekam am Donnerstag, den 11.06., beide freien Wochenenden zugesagt. Im Dienst schloss sich der Lemke-Sturz mit unauffälligem Röntgen, während eine nächtliche Herzaufnahme (Herr Tahir) neue offene Kontrollschleifen öffnete — bewältigt mit Sofort-Doku und einer der seltenen rückstandsfreien Übergaben um 6:15.",
      "created_at": "2026-06-15T08:31:50+00:00"
    },
    {
      "id": "digest_2e26d15fa558437d",
      "persona_id": "persona_a7b9293ffff3e824",
      "scope": "llm_authored_memory_depth",
      "period_start": "2026-03-31",
      "period_end": "2026-05-31",
      "summary": "Über zwei Monate verdichtet sich Annas Kampf gegen den gedrehten Rhythmus: ein elendes Automaten-Tief Ende März und ein unkontrollierter Ess-Vormittag im April geben den Anstoß, das Sonntags-Vorkochen mit Jonas wirklich aufzusetzen, das am 31.05. zum ersten Mal richtig läuft. Parallel fordert eine Sturznacht mit Frau Köhler ihre ganze Sorgfalt und legt offen, dass Meltem die Doku abschiebt, während der Juli-Wunsch nach zwei freien Wochenenden bei Carstens hängt und Anna zum wöchentlichen Nachhaken zwingt — ein roter Faden, der erst im Juni eingelöst wird.",
      "created_at": "2026-06-15T08:31:50+00:00"
    }
  ]
}
